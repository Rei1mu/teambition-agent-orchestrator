{
  "name": "dsh-tba-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "通过文件握手让 tba 的 detached 监听在收到任意回复时主动唤醒 DSH 会话，无需等待后台 job 退出。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "package.json"
  ],
  "scripts": {
    "check": "node --check index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
